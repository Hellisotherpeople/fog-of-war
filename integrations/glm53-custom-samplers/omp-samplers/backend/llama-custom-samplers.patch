diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 61d28ad8a..1411d186a 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -3312,6 +3312,1035 @@ struct llama_sampler * llama_sampler_init_top_n_sigma(float n) {
