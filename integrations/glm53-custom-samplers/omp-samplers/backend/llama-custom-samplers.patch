+// min-k
+
+struct llama_sampler_min_k {
+    const float  tau;      // fallback constant, activated only for near-uniform distributions
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_min_k_name(const struct llama_sampler * /*smpl*/) {
+    return "min-k";
+}
+
+static void llama_sampler_min_k_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_min_k *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+
+    // sort logits in descending order (temperature-invariant: operates on raw logits)
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    // dynamic range R = l_1 - l_min over finite logits (Eq. 1). A tiny epsilon keeps the
+    // near-uniform case (l_1 == l_min) numerically stable.
+    const float l1 = cur_p->data[0].logit;
+    float lmin = l1;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const float l = cur_p->data[i].logit;
+        if (l != -INFINITY) {
+            lmin = std::min(lmin, l);
+        }
+    }
+    const float range = (l1 - lmin) + 1e-8f;
+
+    // weighted relative decay w_i = (l_i - l_{i+1}) / R * (1/i), with i 1-indexed (Eq. 2).
+    // The 1/i weighting emphasizes drops near the head; the cliff is the position of the
+    // steepest weighted decay (Eq. 3).
+    size_t k_cliff = 1;
+    float  best_w  = -INFINITY;
+    for (size_t i = 0; i + 1 < cur_p->size; ++i) {
+        const float li  = cur_p->data[i].logit;
+        const float li1 = cur_p->data[i + 1].logit;
+        if (li == -INFINITY) {
+            break; // remaining tokens are masked; no meaningful cliff beyond here
+        }
+        const float drop = (li1 == -INFINITY) ? (li - lmin) : (li - li1);
+        const float w    = (drop / range) / (float) (i + 1);
+        if (w > best_w) {
+            best_w  = w;
+            k_cliff = i + 1; // keep tokens 1..(i+1)
+        }
+    }
+
+    // fallback candidate size for near-uniform distributions (Eq. 4): k_fallback = floor(tau / R).
+    // The +1e-8 above bounds this; tau < 0 disables the fallback.
+    size_t k_fallback = 0;
+    if (ctx->tau > 0.0f) {
+        const float kf = ctx->tau / range;
+        if (kf > 0.0f) {
+            k_fallback = (size_t) kf;
+        }
+    }
+
+    // final candidate size k = max(k_cliff, k_fallback) (Eq. 5)
+    size_t k = std::max(k_cliff, k_fallback);
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_min_k_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_min_k *) smpl->ctx;
+    return llama_sampler_init_min_k(ctx->tau, ctx->min_keep);
+}
+
+static void llama_sampler_min_k_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_min_k *) smpl->ctx;
+}
+
+static struct llama_sampler_i llama_sampler_min_k_i = {
+    /* .name              = */ llama_sampler_min_k_name,
+    /* .accept            = */ nullptr,
+    /* .apply             = */ llama_sampler_min_k_apply,
+    /* .reset             = */ nullptr,
+    /* .clone             = */ llama_sampler_min_k_clone,
+    /* .free              = */ llama_sampler_min_k_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ nullptr,
+};
+
+struct llama_sampler * llama_sampler_init_min_k(float tau, size_t min_keep) {
+    // min-k is enabled by its presence in the sampler chain; tau only controls the
+    // near-uniform fallback (tau <= 0 disables the fallback, leaving pure cliff detection).
+    return llama_sampler_init(
+        /* .iface = */ &llama_sampler_min_k_i,
+        /* .ctx   = */ new llama_sampler_min_k {
+            /* .tau      = */ tau,
+            /* .min_keep = */ min_keep,
+        }
+    );
+}
