+}
+
+// robust-z (keep logits >= median + coeff*MAD, a median/MAD robust cousin of top-n-sigma;
+// the fat low-probability tail inflates the mean/std that top-n-sigma uses, whereas the
+// median and MAD are unaffected by it. Temperature-invariant.)
+
+struct llama_sampler_robust_z {
+    const float  coeff;
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_robust_z_name(const struct llama_sampler * /*smpl*/) {
+    return "robust-z";
+}
+
+static void llama_sampler_robust_z_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_robust_z *) smpl->ctx;
+
+    if (cur_p->size <= 2) {
+        return;
+    }
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    size_t n = cur_p->size;
+    while (n > 0 && cur_p->data[n - 1].logit == -INFINITY) {
+        --n;
+    }
+    if (n < 2) {
+        return;
+    }
+
+    std::vector<float> v;
+    v.reserve(n);
+    for (size_t i = 0; i < n; ++i) {
+        v.push_back(cur_p->data[i].logit);
+    }
+    const size_t mid = n / 2;
+    std::nth_element(v.begin(), v.begin() + mid, v.end());
+    const double median = (double) v[mid];
+
+    std::vector<float> dev;
+    dev.reserve(n);
+    for (size_t i = 0; i < n; ++i) {
+        dev.push_back(std::fabs((double) v[i] - median));
+    }
+    std::nth_element(dev.begin(), dev.begin() + mid, dev.end());
+    const double mad = (double) dev[mid];
+
+    const double thr = median + (double) ctx->coeff * mad;
+
+    size_t k = 0;
+    for (size_t i = 0; i < n; ++i) {
+        if ((double) cur_p->data[i].logit >= thr) {
+            k = i + 1;
+        } else {
+            break;
+        }
+    }
+
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_robust_z_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_robust_z *) smpl->ctx;
+    return llama_sampler_init_robust_z(ctx->coeff, ctx->min_keep);
+}
+
+static void llama_sampler_robust_z_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_robust_z *) smpl->ctx;
+}
+
+static struct llama_sampler_i llama_sampler_robust_z_i = {
+    /* .name              = */ llama_sampler_robust_z_name,
+    /* .accept            = */ nullptr,
+    /* .apply             = */ llama_sampler_robust_z_apply,
+    /* .reset             = */ nullptr,
+    /* .clone             = */ llama_sampler_robust_z_clone,
+    /* .free              = */ llama_sampler_robust_z_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ nullptr,
+};
+
+struct llama_sampler * llama_sampler_init_robust_z(float coeff, size_t min_keep) {
+    return llama_sampler_init(
+        /* .iface = */ &llama_sampler_robust_z_i,
+        /* .ctx   = */ new llama_sampler_robust_z {
+            /* .coeff    = */ coeff,
+            /* .min_keep = */ min_keep,
+        }
+    );
+}
