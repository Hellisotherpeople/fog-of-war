+
+// kneedle (parameter-free elbow: on the sorted-logit survival curve normalized to the
+// unit square, keep up to the point of maximum distance from the chord joining the
+// endpoints, i.e. the knee / max-curvature point. Temperature-invariant.)
+
+struct llama_sampler_kneedle {
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_kneedle_name(const struct llama_sampler * /*smpl*/) {
+    return "kneedle";
+}
+
+static void llama_sampler_kneedle_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_kneedle *) smpl->ctx;
+
+    if (cur_p->size <= 2) {
+        return;
+    }
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    size_t n = cur_p->size;
+    while (n > 0 && cur_p->data[n - 1].logit == -INFINITY) {
+        --n;
+    }
+    if (n < 3) {
+        return;
+    }
+
+    const double lmax  = (double) cur_p->data[0].logit;
+    const double lmin  = (double) cur_p->data[n - 1].logit;
+    const double range = lmax - lmin;
+    if (range <= 0.0) {
+        return;
+    }
+
+    double best = -1.0;
+    size_t kbest = 1;
+    for (size_t i = 0; i < n; ++i) {
+        const double x = (double) i / (double) (n - 1);
+        const double y = ((double) cur_p->data[i].logit - lmin) / range;
+        const double d = std::fabs(x + y - 1.0); // proportional to distance from the (0,1)->(1,0) chord
+        if (d > best) {
+            best  = d;
+            kbest = i + 1;
+        }
+    }
+
+    size_t k = std::max(kbest, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_kneedle_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_kneedle *) smpl->ctx;
+    return llama_sampler_init_kneedle(ctx->min_keep);
+}
+
+static void llama_sampler_kneedle_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_kneedle *) smpl->ctx;
+}
+
+static struct llama_sampler_i llama_sampler_kneedle_i = {
+    /* .name              = */ llama_sampler_kneedle_name,
+    /* .accept            = */ nullptr,
+    /* .apply             = */ llama_sampler_kneedle_apply,
+    /* .reset             = */ nullptr,
+    /* .clone             = */ llama_sampler_kneedle_clone,
+    /* .free              = */ llama_sampler_kneedle_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ nullptr,
+};
