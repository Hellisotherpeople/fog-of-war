+// Maximum entropy within KL(q || p) <= budget on the incoming support.
+
+struct llama_sampler_kl_budget {
+    const float budget;
+    std::vector<double> gaps;
+};
+
+static const char * llama_sampler_kl_budget_name(const struct llama_sampler * /*smpl*/) {
+    return "kl-budget";
+}
+
+static void llama_sampler_kl_budget_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_kl_budget *) smpl->ctx;
+    if (cur_p->size <= 1 || ctx->budget == 0.0f) {
+        return;
+    }
+    double top = -INFINITY;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (std::isfinite(cur_p->data[i].logit)) {
+            top = std::max(top, (double) cur_p->data[i].logit);
+        }
+    }
+    if (!std::isfinite(top)) {
+        return;
+    }
+    auto & gaps = ctx->gaps;
+    gaps.clear();
+    double z_ref = 0.0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (std::isfinite(cur_p->data[i].logit)) {
+            double gap = cur_p->data[i].logit - top;
+            gaps.push_back(gap);
+            z_ref += std::exp(gap);
+        }
+    }
+    const double log_z_ref = std::log(z_ref);
+    // q_i = p_i^beta / Z. KL decreases as beta goes from 0 (uniform) to 1 (p).
+    auto divergence = [&](double beta) {
+        double z = 0.0, moment = 0.0;
+        for (double gap : gaps) {
+            double w = std::exp(beta * gap);
+            z += w;
+            moment += w * gap;
+        }
+        return (beta - 1.0) * moment / z + log_z_ref - std::log(z);
+    };
+    double beta = 0.0;
+    if (divergence(0.0) > ctx->budget) {
+        double lo = 0.0, hi = 1.0;
+        for (int iteration = 0; iteration < 32; ++iteration) {
+            double mid = (lo + hi) / 2.0;
+            if (divergence(mid) > ctx->budget) {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        beta = hi;
+    }
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        // A uniform draw must not unmask grammar bans or other excluded tokens.
+        if (std::isfinite(cur_p->data[i].logit)) {
+            cur_p->data[i].logit = (float) (beta * (cur_p->data[i].logit - top));
+        }
+    }
+}
+
+static struct llama_sampler * llama_sampler_kl_budget_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_kl_budget *) smpl->ctx;
+    return llama_sampler_init_kl_budget(ctx->budget);
+}
+
+static void llama_sampler_kl_budget_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_kl_budget *) smpl->ctx;
+}
