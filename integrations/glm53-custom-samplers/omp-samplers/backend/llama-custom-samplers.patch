+static void llama_sampler_geo_mean_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_geo_mean *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+
+    llama_sampler_softmax_impl(cur_p, true);
+
+    double h = 0.0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const double p = cur_p->data[i].p;
+        if (p > 0.0) {
+            h -= p * std::log(p);
+        }
+    }
+    const double thr = (double) ctx->coeff * std::exp(-h);
+
+    size_t k = 0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if ((double) cur_p->data[i].p >= thr) {
+            k = i + 1;
+        } else {
+            break;
+        }
+    }
+
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
