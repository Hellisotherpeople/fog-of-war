+// hill (effective-support-size / Hill-number truncation; keeps top ceil(D_q) tokens,
+// where D_q = (sum_i p_i^q)^(1/(1-q)) is the order-q Hill number. q=1 -> keep exp(H)
+// (perplexity-many) tokens; q=2 -> keep 1/sum(p_i^2) (inverse Simpson). A self-tuning top-k.)
+
+struct llama_sampler_hill {
+    const float  order;
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_hill_name(const struct llama_sampler * /*smpl*/) {
+    return "hill";
+}
+
+static void llama_sampler_hill_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_hill *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+
+    llama_sampler_softmax_impl(cur_p, true);
+
+    const double q = (double) ctx->order;
+    double D;
+    if (std::fabs(q - 1.0) < 1e-6) {
+        double h = 0.0;
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            const double p = cur_p->data[i].p;
+            if (p > 0.0) {
+                h -= p * std::log(p);
+            }
+        }
+        D = std::exp(h); // exp(Shannon entropy) = perplexity
+    } else {
+        double s = 0.0;
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            const double p = cur_p->data[i].p;
+            if (p > 0.0) {
+                s += std::pow(p, q);
+            }
+        }
+        D = (s > 0.0) ? std::pow(s, 1.0 / (1.0 - q)) : 1.0;
+    }
+
+    size_t k = (size_t) std::ceil(D);
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_hill_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_hill *) smpl->ctx;
+    return llama_sampler_init_hill(ctx->order, ctx->min_keep);
+}
