+// top-H
+
+struct llama_sampler_top_h {
+    const float  alpha;    // entropy bound coefficient in (0, 1)
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_top_h_name(const struct llama_sampler * /*smpl*/) {
+    return "top-h";
+}
+
+static void llama_sampler_top_h_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_top_h *) smpl->ctx;
+
+    if (ctx->alpha <= 0.0f || ctx->alpha >= 1.0f || cur_p->size <= 1) {
+        return;
+    }
+
+    // compute probabilities (and sort descending)
+    llama_sampler_softmax_impl(cur_p, true);
+
+    // entropy of the full (renormalized) distribution H(p)
+    double h_p = 0.0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const double p = cur_p->data[i].p;
+        if (p > 0.0) {
+            h_p -= p * std::log(p);
+        }
+    }
+
+    const double bound = (double) ctx->alpha * h_p;
+
+    // greedily grow the candidate set in descending-probability order, tracking the entropy of the
+    // renormalized subset via incremental accumulation (Alg. 2): with cumulative mass G and
+    // partial sum s = sum p_i ln p_i, H(q) = ln(G) - s/G. Stop before H(q) would exceed alpha*H(p).
+    double gamma = 0.0; // cumulative selected mass
+    double s     = 0.0; // running sum of p_i * ln(p_i) over selected tokens
+    size_t k     = 0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const double p = cur_p->data[i].p;
+        const double gamma_new = gamma + p;
+        const double s_new     = s + (p > 0.0 ? p * std::log(p) : 0.0);
+        const double h_q       = gamma_new > 0.0 ? (std::log(gamma_new) - s_new / gamma_new) : 0.0;
+
+        if (k >= 1 && h_q > bound) {
+            break;
+        }
+
+        gamma = gamma_new;
+        s     = s_new;
+        k     = i + 1;
+    }
+
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_top_h_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_top_h *) smpl->ctx;
+    return llama_sampler_init_top_h(ctx->alpha, ctx->min_keep);
+}
+
+static void llama_sampler_top_h_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_top_h *) smpl->ctx;
+}
