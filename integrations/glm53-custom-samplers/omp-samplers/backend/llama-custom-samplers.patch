+// otsu (parameter-free bipartition of the RAW logits, maximizing between-class
+// variance w0*w1*(mu0-mu1)^2 over all split points; keeps the high class. Finds the
+// natural "signal vs noise" break with no hyperparameter. Temperature-invariant.)
+
+struct llama_sampler_otsu {
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_otsu_name(const struct llama_sampler * /*smpl*/) {
+    return "otsu";
+}
+
+static void llama_sampler_otsu_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_otsu *) smpl->ctx;
+
+    if (cur_p->size <= 2) {
+        return;
+    }
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    // restrict to finite logits (masked -inf tokens sink to the bottom of the desc sort)
+    size_t n = cur_p->size;
+    while (n > 0 && cur_p->data[n - 1].logit == -INFINITY) {
+        --n;
+    }
+    if (n <= 2) {
+        return;
+    }
+
+    double sum_all = 0.0;
+    for (size_t i = 0; i < n; ++i) {
+        sum_all += (double) cur_p->data[i].logit;
+    }
+
+    double sum0 = 0.0, best = -1.0;
+    size_t kbest = 1;
+    for (size_t t = 1; t < n; ++t) {
+        sum0 += (double) cur_p->data[t - 1].logit;
+        const double w0  = (double) t / (double) n;
+        const double w1  = 1.0 - w0;
+        const double mu0 = sum0 / (double) t;
+        const double mu1 = (sum_all - sum0) / (double) (n - t);
+        const double b   = w0 * w1 * (mu0 - mu1) * (mu0 - mu1);
+        if (b > best) {
+            best  = b;
+            kbest = t;
+        }
+    }
+
+    size_t k = std::max(kbest, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_otsu_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_otsu *) smpl->ctx;
