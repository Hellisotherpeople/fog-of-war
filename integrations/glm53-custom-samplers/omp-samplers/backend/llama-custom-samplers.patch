+struct llama_sampler * llama_sampler_init_kneedle(size_t min_keep) {
+    return llama_sampler_init(
+        /* .iface = */ &llama_sampler_kneedle_i,
+        /* .ctx   = */ new llama_sampler_kneedle {
+            /* .min_keep = */ min_keep,
