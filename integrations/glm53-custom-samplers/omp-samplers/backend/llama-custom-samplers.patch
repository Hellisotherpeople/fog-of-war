+// p-less
+
+struct llama_sampler_p_less {
+    const float  exponent; // Renyi order q of the threshold L = sum_i p_i^q (q = 2 -> classic collision probability)
+    const bool   norm;
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_p_less_name(const struct llama_sampler * /*smpl*/) {
+    return "p-less";
+}
+
+static void llama_sampler_p_less_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_p_less *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+
+    // compute probabilities (and sort descending)
+    llama_sampler_softmax_impl(cur_p, true);
+
+    // generalized collision-probability threshold L = sum_i p_i^q, where q = ctx->exponent is the
+    // Renyi order (q = 2 recovers the classic collision probability / Eq. 2 of p-less). For q > 1,
+    // larger q shrinks L, lowering the threshold and keeping more tokens (more diverse); q -> 1+
+    // tightens L toward 1 (greedy). q = 2 keeps the exact original numerics via a p*p fast path.
+    const double q = (double) ctx->exponent;
+    double l = 0.0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const double p = cur_p->data[i].p;
+        if (p > 0.0) {
+            l += (q == 2.0) ? (p * p) : std::pow(p, q);
+        }
+    }
+
+    // p-less_norm rescales L from its natural [n^(1-q), 1] range to [0, 1] (diversity-favoring),
+    // where n^(1-q) = sum_i p_i^q for the uniform distribution. For q = 2 this reduces to the
+    // classic L_norm = (n/(n-1)) L - 1/(n-1) (Eq. 6).
+    if (ctx->norm) {
+        const double n = (double) cur_p->size;
+        if (n > 1.0) {
+            const double l_min = std::pow(n, 1.0 - q);
+            if (l_min < 1.0) {
+                l = (l - l_min) / (1.0 - l_min);
+            }
+        }
+    }
+
+    // keep tokens whose probability is at least the threshold (Eq. 3). Since the array is sorted
+    // descending and the max probability is guaranteed >= L, at least one token survives.
+    size_t k = 0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if ((double) cur_p->data[i].p >= l) {
+            k = i + 1;
+        } else {
+            break;
+        }
+    }
+
+    k = std::max(k, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_p_less_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_p_less *) smpl->ctx;
+    return llama_sampler_init_p_less(ctx->exponent, ctx->norm, ctx->min_keep);
+}
+
+static void llama_sampler_p_less_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_p_less *) smpl->ctx;
+}
