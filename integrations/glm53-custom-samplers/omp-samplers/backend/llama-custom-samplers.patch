+
+// KL*: minimize -lambda*log(k) - mean(log p) over sorted prefixes.
+
+struct llama_sampler_kl_opt {
+    const float  lambda;
+    const bool   global;    // scan the whole vector for the global minimum instead of stopping early
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_kl_opt_name(const struct llama_sampler * /*smpl*/) {
+    return "kl-opt";
+}
+
+static void llama_sampler_kl_opt_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_kl_opt *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    // log Z cancels across k. Logit gaps avoid softmax underflow in the tail.
+    const double top = cur_p->data[0].logit;
+    if (!std::isfinite(top)) {
+        return;
+    }
+    double sum_gap = 0.0;
+    double best_j = 0.0;
+    double previous_j = 0.0;
+    size_t best_k = 1;
+    size_t finite_count = 0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (!std::isfinite(cur_p->data[i].logit)) {
+            break;
+        }
+        ++finite_count;
+        sum_gap += top - (double) cur_p->data[i].logit;
+        const size_t k = i + 1;
+        const double j = sum_gap / k - ctx->lambda * std::log((double) k);
+        if (!ctx->global && i > 0 && j > previous_j) {
+            break;
+        }
+        if (!ctx->global || j < best_j) {
+            best_j = j;
+            best_k = k;
+        }
+        previous_j = j;
+    }
+    // min_keep must never bring back a masked token.
+    while (finite_count < cur_p->size && finite_count < ctx->min_keep &&
+           std::isfinite(cur_p->data[finite_count].logit)) {
+        ++finite_count;
+    }
+    cur_p->size = std::min(finite_count, std::max(best_k, std::max<size_t>(1, ctx->min_keep)));
+}
+
+static struct llama_sampler * llama_sampler_kl_opt_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_kl_opt *) smpl->ctx;
+    return llama_sampler_init_kl_opt(ctx->lambda, ctx->global, ctx->min_keep);
+}
+
+static void llama_sampler_kl_opt_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_kl_opt *) smpl->ctx;
+}
