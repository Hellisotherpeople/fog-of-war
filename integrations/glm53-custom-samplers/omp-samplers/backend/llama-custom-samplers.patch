+static void test_kl_budget() {
+    const std::vector<float> logits = {0.0f, -1.0f, -3.0f, -INFINITY};
+    double previous_h = -1.0;
+    for (float budget : {0.0f, 0.00001f, 0.01f, 0.1f, 0.3f, 1.0f, 20.0f}) {
+        std::vector<llama_token_data> data;
+        for (size_t i = 0; i < logits.size(); ++i) data.push_back({(llama_token) i, logits[i], 0});
+        llama_token_data_array cur = {data.data(), data.size(), -1, false};
+        auto * smpl = llama_sampler_init_kl_budget(budget);
+        auto * clone = llama_sampler_clone(smpl);
+        llama_sampler_free(smpl);
+        llama_sampler_apply(clone, &cur);
+        llama_sampler_free(clone);
+        GGML_ASSERT(cur.data[3].logit == -INFINITY);
+        auto * dist = llama_sampler_init_dist(0);
+        llama_sampler_apply(dist, &cur);
+        llama_sampler_free(dist);
+        const double log_z = std::log(1.0 + std::exp(-1.0) + std::exp(-3.0));
+        double kl = 0, h = 0;
+        for (size_t i = 0; i < 3; ++i) {
+            double q = cur.data[i].p;
+            kl += q * (std::log(q) - logits[i] + log_z);
+            h -= q * std::log(q);
+        }
+        GGML_ASSERT(kl <= budget + 1e-6);
+        GGML_ASSERT(h >= previous_h - 1e-6);
+        previous_h = h;
+        const double uniform_kl = 4.0 / 3.0 + log_z - std::log(3.0);
+        if (budget < uniform_kl) {
+            GGML_ASSERT(std::abs(kl - budget) < 1e-6);
+        } else {
+            GGML_ASSERT(std::abs(h - std::log(3.0)) < 1e-6);
+        }
+        // Check the entropy optimum against all points on a three-token simplex grid.
+        for (int a = 1; a < 100; ++a) {
+            for (int b = 1; b < 100 - a; ++b) {
+                double q[] = {a / 100.0, b / 100.0, (100 - a - b) / 100.0};
+                double grid_kl = 0, grid_h = 0;
+                for (int i = 0; i < 3; ++i) {
+                    grid_kl += q[i] * (std::log(q[i]) - logits[i] + log_z);
+                    grid_h -= q[i] * std::log(q[i]);
+                }
+                if (grid_kl <= budget) GGML_ASSERT(grid_h <= h + 1e-6);
+            }
+        }
+    }
+    // Large finite gaps must remain usable even when reference softmax underflows.
+    std::vector<llama_token_data> tail = {{0, 0.0f, 0}, {1, -1000.0f, 0}};
+    llama_token_data_array cur = {tail.data(), tail.size(), -1, false};
+    auto * smpl = llama_sampler_init_kl_budget(0.1f);
+    llama_sampler_apply(smpl, &cur);
+    llama_sampler_free(smpl);
+    GGML_ASSERT(std::isfinite(cur.data[1].logit));
+    GGML_ASSERT(cur.data[1].logit < -8.0f);
+}
+
+static void test_kl_opt() {
+    auto check = [](std::vector<float> logits, float lambda, bool global, size_t min_keep, size_t expected) {
+        std::vector<llama_token_data> data;
+        for (size_t i = 0; i < logits.size(); ++i) {
+            data.push_back({(llama_token) i, logits[i], 0.0f});
+        }
+        llama_token_data_array cur = {data.data(), data.size(), -1, false};
+        auto * sampler = llama_sampler_init_kl_opt(lambda, global, min_keep);
+        auto * clone = llama_sampler_clone(sampler);
+        llama_sampler_free(sampler);
+        llama_sampler_apply(clone, &cur);
+        GGML_ASSERT(cur.size == expected);
+        GGML_ASSERT(cur.sorted || cur.size <= 1);
+        for (size_t i = 0; i < cur.size; ++i) {
+            GGML_ASSERT(std::isfinite(cur.data[i].logit));
+        }
+        llama_sampler_free(clone);
+    };
+    check({0}, 1, true, 1, 1);
+    check({0, 0, 0, 0}, 1, true, 1, 4);
+    check({0, -20, -40}, 1, true, 1, 1);
+    check({std::log(0.4f), std::log(0.3f), std::log(0.2f), std::log(0.07f), std::log(0.03f)}, 1, true, 1, 3);
+    check({0, -2, -2, -2, -2, -2, -2, -2}, 1, true, 1, 8);
+    check({0, -2, -2, -2, -2, -2, -2, -2}, 1, false, 1, 1);
+    check({0, -1000, -2000}, 1, true, 2, 2);
+    check({0, -INFINITY, -INFINITY}, 1, true, 3, 1);
+    check({0, -1, -2}, 0, true, 1, 1);
+    check({0, 0, 0}, 0, true, 1, 1);
+    check({0, 0, 0}, 0, false, 1, 3);
+    // Exhaustive prefix objective on deterministic distributions, including underflowing tails.
+    for (int trial = 0; trial < 100; ++trial) {
+        std::vector<float> z;
+        for (int i = 0; i < 37; ++i) {
+            z.push_back(-float((trial * 17 + i * 29) % 131) / (trial % 3 == 0 ? 0.1f : 10.0f));
+        }
+        auto sorted = z;
+        std::sort(sorted.begin(), sorted.end(), std::greater<float>());
+        for (float lambda : {0.0f, 0.5f, 1.0f, 1.5f, 3.0f}) {
+            double sum = 0, best = INFINITY;
+            size_t k_best = 1;
+            for (size_t k = 1; k <= sorted.size(); ++k) {
+                sum += sorted[0] - (double) sorted[k - 1];
+                double objective = sum / k - lambda * std::log((double) k);
+                if (objective < best) { best = objective; k_best = k; }
+            }
+            check(z, lambda, true, 1, k_best);
+        }
+    }
+}
