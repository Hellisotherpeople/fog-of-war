+// geo-mean (geometric-mean-probability threshold; keep p_i >= coeff * exp(-H),
+// i.e. every token more probable than the "typical" token. coeff < 1 relaxes
+// (more diverse), coeff > 1 tightens. Threshold-form dual of hill at q=1.)
+
+struct llama_sampler_geo_mean {
+    const float  coeff;
+    const size_t min_keep;
+};
