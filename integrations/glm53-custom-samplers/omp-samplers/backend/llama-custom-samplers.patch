+}
+
+// top-gap (keep the head above the single largest logit gap l_i - l_{i+1}. Parameter-free
+// and temperature-invariant. Aggressive/tight by nature -- a coherence floor, not a
+// creativity lever -- since the biggest gap often sits right below the dominant tokens.)
+
+struct llama_sampler_top_gap {
+    const size_t min_keep;
+};
+
+static const char * llama_sampler_top_gap_name(const struct llama_sampler * /*smpl*/) {
+    return "top-gap";
+}
+
+static void llama_sampler_top_gap_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_top_gap *) smpl->ctx;
+
+    if (cur_p->size <= 1) {
+        return;
+    }
+    if (!cur_p->sorted) {
+        llama_token_data_array_partial_sort_inplace(cur_p, cur_p->size);
+    }
+
+    size_t n = cur_p->size;
+    while (n > 0 && cur_p->data[n - 1].logit == -INFINITY) {
+        --n;
+    }
+    if (n < 2) {
+        return;
+    }
+
+    double best = -1.0;
+    size_t kbest = 1;
+    for (size_t i = 0; i + 1 < n; ++i) {
+        const double gap = (double) cur_p->data[i].logit - (double) cur_p->data[i + 1].logit;
+        if (gap > best) {
+            best  = gap;
+            kbest = i + 1;
+        }
+    }
+
+    size_t k = std::max(kbest, ctx->min_keep);
+    k = std::max<size_t>(k, 1);
+    k = std::min(k, cur_p->size);
+
+    cur_p->size = k;
+}
+
+static struct llama_sampler * llama_sampler_top_gap_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_top_gap *) smpl->ctx;
+    return llama_sampler_init_top_gap(ctx->min_keep);
+}
+
+static void llama_sampler_top_gap_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_top_gap *) smpl->ctx;
+}
+
+static struct llama_sampler_i llama_sampler_top_gap_i = {
